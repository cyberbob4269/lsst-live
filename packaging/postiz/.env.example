# Postiz stack configuration — copy this file to packaging/postiz/.env and edit.
# Vera Terminal starts the stack with:
#   docker compose --env-file packaging/postiz/.env -f packaging/postiz/docker-compose.yml up -d
# .env is git-ignored; never commit real secrets.

# Any long random string, unique per install. REPLACE THIS before starting.
JWT_SECRET=change-me-random-replace-with-a-long-random-string

# These match the postiz-postgres / postiz-redis services in docker-compose.yml —
# only change them if you also change the compose services.
DATABASE_URL=postgresql://postiz-user:postiz-password@postiz-postgres:5432/postiz-db-local
REDIS_URL=redis://postiz-redis:6379

# Local URLs — the compose file maps 4007:5000, keep these as-is.
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api

# From your X developer app — same credentials you use in vera-home.
X_API_KEY=
X_API_SECRET=
